# ─────────────────────────────────────────────────────────────────────────────
# NeuroWealth Agent — local development environment variables
# Copy this file to .env.local and fill in your secrets.
# .env.local is git-ignored and MUST NOT be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=neurowealth
# Overridden inside docker-compose by the service DNS name; set for local dev:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/neurowealth

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Stellar / Soroban ─────────────────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VAULT_CONTRACT_ID=

# ── AI / OpenAI ───────────────────────────────────────────────────────────────
# Comma-separated list for key rotation
OPENAI_API_KEYS=sk-replace-me

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
USER_RATE_LIMIT_MAX_REQUESTS=20

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── DB pool ───────────────────────────────────────────────────────────────────
MAX_DB_POOL_SIZE=10
MIN_DB_POOL_SIZE=2
