# NeuroWealth staging environment
# Copy to .env.staging locally. Never commit the populated file.
# All Stellar values in this file must target testnet, never mainnet.

APP_ENV=staging
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Set locally only when reusing a funded testnet account. CI uses the
# STAGING_DEPLOYER_SECRET_KEY repository/environment secret instead.
STAGING_DEPLOYER_SECRET_KEY=
STAGING_VAULT_CONTRACT_ID=
STAGING_USDC_TOKEN_ADDRESS=
STAGING_AGENT_ADDRESS=

# Frontend build-time values. These are public and must contain testnet data.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_VAULT_CONTRACT_ID=
NEXT_PUBLIC_WS_URL=

# Railway staging agent. Keep the database URL in the Railway secret store.
DATABASE_URL=
PORT=3001
METRICS_PORT=9100
OPENAI_API_KEYS=

# Weekly reset job. This must be a separate Supabase staging project.
STAGING_DATABASE_URL=